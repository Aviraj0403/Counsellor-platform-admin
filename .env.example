# Admin app (Vite). Copy to .env. VITE_* values are embedded in the public bundle: NEVER put secrets here.
# Must end with /api/v1 and the API's CORS_ORIGINS must include this app's own origin.
VITE_API_BASE_URL=https://apicounsellor.jdinfotechsolutions.in/api/v1
VITE_SUPPORT_EMAIL=support@jdinfotechsolutions.in

# Optional: image for the left panel of the sign-in page (URL or path). Default is /login-hero.jpg from public/.
# VITE_LOGIN_IMAGE=/login-hero.jpg
